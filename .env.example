# URL pública do Backend Spring Boot (HTTPS em produção)
VITE_API_URL=http://localhost:8080

# URLs entre os 4 portais (em produção use os domínios da Vercel)
VITE_APP_LANDING_URL=http://localhost:5173
VITE_APP_MAE_URL=http://localhost:5174
VITE_APP_TERAPEUTA_URL=http://localhost:5175
VITE_APP_RH_URL=http://localhost:5176
